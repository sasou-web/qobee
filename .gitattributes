# Default to LF for tracked text files. Windows tooling that needs
# CRLF (mostly batch / PowerShell scripts) gets it through the
# explicit overrides below; Cargo.lock and other text files keep
# LF so the repo stays cross-platform clean.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Windows-specific scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git hooks and POSIX shell scripts must be LF, even on Windows —
# git's bundled bash (which runs the hooks) chokes on CRLF.
.githooks/** text eol=lf
*.sh text eol=lf
