{
  "identifier": "default",
  "description": "Default capability for the main Qobee window: lets the UI invoke our app commands and receive events.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:webview:default",
    "dialog:allow-open"
  ]
}
