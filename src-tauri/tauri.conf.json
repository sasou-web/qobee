{
  "productName": "Qobee",
  "version": "0.3.0",
  "identifier": "app.qobee.player",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qobee",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "A local audio player for Windows, focused on fidelity.",
    "longDescription": "Qobee indexes a music folder and plays FLAC and other lossless formats through a careful audio path. No cloud, no streaming, no telemetry. Built with Rust + Tauri + Svelte.",
    "copyright": "Qobee contributors",
    "publisher": "Qobee",
    "homepage": "https://github.com/qobee/qobee",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "installer/qobee.nsh"
      }
    }
  }
}
