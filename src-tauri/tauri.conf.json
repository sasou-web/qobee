{
  "productName": "Qobee",
  "version": "0.5.2",
  "identifier": "app.qobee.player",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qobee",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost qobee-cover: http://qobee-cover.localhost https://qobee-cover.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sasou-web/qobee/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQkE3MENGOEU2M0Q3NDgKUldSSTEyT096M0M2Z014eDlGd2xheHRwbFB1bCtSRjhMRW9nTms4cFNYTy9zQVo3MkRWaEFVSzQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "A simple, fast local audio player.",
    "longDescription": "Qobee indexes a music folder and plays your local library (FLAC, MP3, AAC/M4A, WAV, OGG and more) with a simple, stable playback engine. No cloud, no streaming, no telemetry. Built with Rust + Tauri + Svelte.",
    "copyright": "Qobee contributors",
    "publisher": "Qobee",
    "homepage": "https://github.com/sasou-web/qobee",
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "installer/qobee.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    }
  }
}
