# Rust / Cargo
target/
**/*.rs.bk
# Cargo.lock is committed: this workspace produces a binary
# application (qobee-app), so reproducible builds matter.

# Tauri build output
src-tauri/target/
src-tauri/gen/schemas/

# Local dev override that disables the beforeDevCommand hook;
# only meaningful on the maintainer's box where `npm --prefix ../ui`
# resolves wrong because of a parent-folder name shadowing.
src-tauri/tauri.conf.dev-override.json

# Node / Vite
node_modules/
ui/dist/
ui/.vite/
ui/.svelte-kit/

# IDE / OS
.vscode/
.idea/
.kiro/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log

# Environment / secrets
.env
.env.local

# Qobee runtime data (created by app at runtime, never committed)
qobee-data/
